# Copernicus Data Space OAuth client (dataspace.copernicus.eu -> account -> OAuth clients)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Climate Data Store API key (cds.climate.copernicus.eu/profile)
CDS_API_KEY=

# NASA FIRMS map key (firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=

# Local Supabase — firefinder runs on the 55420 range
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
